<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        xmlns:viewmodels="using:Code_Ruins.ViewModels"
        Height="350"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaToDecorationsHint="False"
        WindowDecorations="None" 
        IsVisible="False"
        x:Class="Code_Ruins.Views.ChattingBox"
        Title="ChattingBox"
        
        x:DataType="viewmodels:MainWindowViewModel"
        Background="{Binding ThemeViewModel.OpacityColor}"
        
        >
        <Grid>
            <Border  Margin="10" x:Name="ChattingBoxBorder" Background="{Binding ThemeViewModel.OpacityDarkFillColor}" BorderThickness="3" BorderBrush="{Binding ThemeViewModel.LightFillColor}" PointerPressed="ChattingBoxBorder_PointerPressed">
                    <Grid>
                         <TextBlock FontSize="20" FontFamily="/Assets/#Zpix"  x:Name="ChattingTextBlock" Text="{Binding ChattingBoxViewModel.RecentText}" Foreground="{Binding ThemeViewModel.NeonGreen}" Margin="30,30,30,30"></TextBlock>
                         <TextBlock FontSize="20" FontFamily="/Assets/#Zpix" Text="▼" Foreground="{Binding ThemeViewModel.NeonGreen}" Margin="20,20,20,20" HorizontalAlignment="Right" VerticalAlignment="Bottom"></TextBlock>
                    </Grid>
         
                </Border>
            
        </Grid>
    
</Window>
